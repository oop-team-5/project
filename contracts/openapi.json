{
  "components": {
    "schemas": {
      "DashboardSnapshot": {
        "description": "한 번의 갱신 결과. fetchedAt은 시간대가 있는 수집 완료 시각이다.",
        "properties": {
          "districtStats": {
            "additionalProperties": {
              "$ref": "#/components/schemas/StationStats"
            },
            "title": "Districtstats",
            "type": "object"
          },
          "fetchedAt": {
            "format": "date-time",
            "title": "Fetchedat",
            "type": "string"
          },
          "shortageStationIds": {
            "items": {
              "type": "string"
            },
            "title": "Shortagestationids",
            "type": "array"
          },
          "stations": {
            "items": {
              "$ref": "#/components/schemas/StationView"
            },
            "title": "Stations",
            "type": "array"
          },
          "summary": {
            "$ref": "#/components/schemas/StationStats"
          }
        },
        "required": [
          "fetchedAt",
          "summary",
          "districtStats",
          "stations",
          "shortageStationIds"
        ],
        "title": "DashboardSnapshot",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "enum": [
              "NOT_IMPLEMENTED",
              "DATA_SOURCE_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "description": "프로세스 실행 상태이며 데이터 수집 구현 완료를 의미하지 않는다.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "StationStats": {
        "description": "평균은 유효한 대여소별 거치율의 단순 평균, 단위는 퍼센트다.",
        "properties": {
          "availableBikes": {
            "title": "Availablebikes",
            "type": "integer"
          },
          "averageOccupancyRate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Averageoccupancyrate"
          },
          "normalCount": {
            "title": "Normalcount",
            "type": "integer"
          },
          "shortageCount": {
            "title": "Shortagecount",
            "type": "integer"
          },
          "stationCount": {
            "title": "Stationcount",
            "type": "integer"
          },
          "surplusCount": {
            "title": "Surpluscount",
            "type": "integer"
          },
          "totalRacks": {
            "title": "Totalracks",
            "type": "integer"
          },
          "unknownCount": {
            "title": "Unknowncount",
            "type": "integer"
          }
        },
        "required": [
          "stationCount",
          "totalRacks",
          "availableBikes",
          "averageOccupancyRate",
          "shortageCount",
          "normalCount",
          "surplusCount",
          "unknownCount"
        ],
        "title": "StationStats",
        "type": "object"
      },
      "StationView": {
        "description": "브라우저로 전달하는 대여소 한 개. 계산된 값을 그대로 표시한다.",
        "properties": {
          "availableBikes": {
            "title": "Availablebikes",
            "type": "integer"
          },
          "district": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "District"
          },
          "latitude": {
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "type": "number"
          },
          "occupancyRate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occupancyrate"
          },
          "stationId": {
            "title": "Stationid",
            "type": "string"
          },
          "stationName": {
            "title": "Stationname",
            "type": "string"
          },
          "status": {
            "enum": [
              "shortage",
              "normal",
              "surplus",
              "unknown"
            ],
            "title": "Status",
            "type": "string"
          },
          "totalRacks": {
            "title": "Totalracks",
            "type": "integer"
          }
        },
        "required": [
          "stationId",
          "stationName",
          "totalRacks",
          "availableBikes",
          "latitude",
          "longitude",
          "district",
          "occupancyRate",
          "status"
        ],
        "title": "StationView",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "공통 응답 계약. 수집·저장·분석·시각화는 팀원별 구현 예정입니다.",
    "title": "Seoul Cycle API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/dashboard/refresh": {
      "post": {
        "description": "본문이 없는 요청. refreshData가 완료된 후 같은 객체에서 결과를 읽는다.",
        "operationId": "refreshDashboard",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardSnapshot"
                }
              }
            },
            "description": "Successful Response"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "아직 구현되지 않은 기능"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "외부 데이터 수집 실패"
          }
        },
        "summary": "전체 데이터 갱신 후 하나의 대시보드 스냅샷 반환"
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "서버 실행 상태 확인"
      }
    }
  }
}
